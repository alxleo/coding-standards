{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Python packages installed in the image",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["(?<depName>[a-zA-Z0-9_.-]+)==(?<currentValue>[0-9.]+)"],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Update npm packages installed in the image",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "(?<depName>(?:@[a-zA-Z0-9_.-]+/)?[a-zA-Z0-9_.-]+)@(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Update the MegaLinter engine",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["megalinter\\.git@v(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "oxsecurity/megalinter",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update checksum-pinned GitHub release binaries",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+_VERSION=\\\"(?<currentValue>[0-9.]+)\\\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Pin Docker image digests and auto-update",
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Group all npm tool updates",
      "matchManagers": ["npm"],
      "groupName": "npm tools"
    },
    {
      "description": "Group all pre-commit hook updates",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    }
  ]
}
