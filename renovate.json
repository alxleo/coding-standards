{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "pre-commit": {
    "enabled": true
  },
  "pep723": {
    "managerFilePatterns": ["/^stock\/[^/]+\\.py$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Python packages installed in the image",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["(?<depName>[a-zA-Z0-9_.-]+)==(?<currentValue>[0-9.]+)"],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Update npm packages installed in the image",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "(?<depName>(?:@[a-zA-Z0-9_.-]+/)?[a-zA-Z0-9_.-]+)@(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Update the MegaLinter engine",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["megalinter\\.git@v(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "oxsecurity/megalinter",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update stock pins embedded in a workflow expression and schema URL",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/stock-lint\\.yml$/", "/^stock\\/mega-linter\\.yml$/"],
      "matchStrings": [
        "(?<depName>ghcr\\.io/oxsecurity/megalinter-cupcake):(?<currentValue>v[0-9.]+)@(?<currentDigest>sha256:[0-9a-f]{64})",
        "raw\\.githubusercontent\\.com/(?<depName>oxsecurity/megalinter)/(?<currentValue>v[0-9.]+)/megalinter/descriptors/schemas/"
      ],
      "datasourceTemplate": "{{#if currentDigest}}docker{{else}}github-releases{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Pin Docker image digests and auto-update",
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Update all stock MegaLinter images for a release together",
      "matchFileNames": ["stock/Dockerfile.images", "stock/mega-linter.yml", ".github/workflows/stock-lint.yml"],
      "matchPackageNames": ["/^ghcr\\.io\\/oxsecurity\\/megalinter-(only-|cupcake$)/", "oxsecurity/megalinter"],
      "groupName": "Stock MegaLinter release",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },
    {
      "description": "Group all npm tool updates",
      "matchManagers": ["npm"],
      "groupName": "npm tools"
    },
    {
      "description": "Group all pre-commit hook updates",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    }
  ]
}
